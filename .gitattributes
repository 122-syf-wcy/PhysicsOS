* text=auto eol=lf

# Native Windows launchers need CRLF; shared source stays LF on every machine.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.jar binary

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.pdf binary

UI/**/*.png filter=lfs diff=lfs merge=lfs -text
docs/**/*.png filter=lfs diff=lfs merge=lfs -text
# Unified patches contain a single-space context marker on blank lines.
overlays/harness/upstream-changes.patch whitespace=-blank-at-eol

# Preserve upstream library/license bytes and the SRT cue separator at EOF.
demos/experiment-directions/vendor/three.core.js whitespace=-space-before-tab
promo-video/**/OFL-NotoSansSC.txt whitespace=-blank-at-eol
promo-video/**/*.srt whitespace=-blank-at-eof
