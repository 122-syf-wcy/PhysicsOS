{
  "name": "@physicsos/mobile-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Offline Android lab and mathematical document assets; shared engines run in a bounded Worker",
  "scripts": {
    "build": "node ../../scripts/android/build-lab.mjs",
    "test": "node ./scripts/test.mjs",
    "test:e2e": "node ./scripts/test.mjs --e2e",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "dompurify": "3.4.11",
    "katex": "0.16.47",
    "marked": "16.4.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.28.1",
    "typescript": "6.0.3"
  },
  "engines": { "node": ">=24.7.0" }
}
