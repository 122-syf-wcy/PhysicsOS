# PhysicsOS local config. Copy to .env and keep secrets out of git.
# DeepSeek / model credentials belong to server-side Agent Service later.
# Do not put API keys in apps/web.

# ---------------------------------------------------------------------------
# Development-only image generation (design assets).
# Used ONLY by scripts/design/generate-physics-assets.mjs (Node, never browser).
# Fill these in .env (gitignored). Never commit real values.
# ---------------------------------------------------------------------------
PHYSICSOS_IMAGE_PRIMARY_BASE_URL=
PHYSICSOS_IMAGE_PRIMARY_API_KEY=
PHYSICSOS_IMAGE_PRIMARY_MODEL=

PHYSICSOS_IMAGE_SECONDARY_BASE_URL=
PHYSICSOS_IMAGE_SECONDARY_API_KEY=
PHYSICSOS_IMAGE_SECONDARY_MODEL=

# ---------------------------------------------------------------------------
# PhysicsOS agent model route (Harness `llm-pi-ai` provider profile).
# The real key lives in ~/.dsh/.env (harness home), never in this repo — the
# settings.yaml provider profile references it by NAME via `apiKeyEnv`.
# Tests/smoke read it from the process env or ~/.dsh/.env.
# ---------------------------------------------------------------------------
PHYSICSOS_MODEL_API_KEY=
# The gateway blocks the default OpenAI SDK User-Agent; the provider profile
# therefore pins a custom `User-Agent` header in ~/.dsh/settings.yaml.

# ---------------------------------------------------------------------------
# Production deployment (docker compose). Every value below is a PATH to a
# secret file, not the secret itself — compose mounts the file and
# scripts/docker-entrypoint.mjs materialises <NAME> into the environment.
# Create them once per environment; never commit real values.
# See docs/13-DEPLOYMENT-OPERATIONS.md §3 for the generation commands.
# ---------------------------------------------------------------------------
PHYSICSOS_POSTGRES_PASSWORD_FILE=./.env.postgres_password
PHYSICSOS_REDIS_PASSWORD_FILE=./.env.redis_password
PHYSICSOS_DATABASE_URL_FILE=./.env.database_url
PHYSICSOS_REDIS_URL_FILE=./.env.redis_url
PHYSICSOS_DEEPSEEK_API_KEY_FILE=./.env.deepseek_api_key
# Bootstraps the first SUPER_ADMIN. Without it a fresh deployment has no
# administrator at all: self-registration only creates students.
PHYSICSOS_ADMIN_PASSWORD_FILE=./.env.admin_password
# Question-image generation for the paper studio; without it the studio falls
# back to placeholder captions instead of题图.
PHYSICOS_IMAGE_API_KEY_FILE=./.env.image_api_key

# ---------------------------------------------------------------------------
# Optional deployment overrides (plain environment values, not secret files).
# ---------------------------------------------------------------------------
# Compose image and host port. Keep these aligned with CI/release metadata.
PHYSICSOS_APP_IMAGE=physicsos-app:local
NODE_IMAGE=node:24.7.0-bookworm-slim
PHYSICSOS_HTTP_PORT=3080
# Exact IP literals of the TLS-terminating proxy (CIDR and hostnames are
# rejected at startup). Empty means "no proxy": cookies lose `Secure` and every
# visitor shares one rate-limit bucket.
PHYSICOS_TRUSTED_PROXIES=
# Point this at shared storage before running more than one app replica;
# sessions otherwise live inside that container's own volume.
PHYSICSOS_SESSIONS_ROOT=/var/lib/physicsos/sessions
# A4 export tools inside the image; override only if you install them elsewhere.
PHYSICSOS_PANDOC=/usr/bin/pandoc
PHYSICSOS_SOFFICE=/usr/bin/soffice
# PostgreSQL schema and TLS. The storage/state backends themselves are fixed to
# postgres/redis by Compose so production cannot silently fall back.
PHYSICSOS_STORAGE_SCHEMA=physicsos
PHYSICSOS_DATABASE_SSL=false
