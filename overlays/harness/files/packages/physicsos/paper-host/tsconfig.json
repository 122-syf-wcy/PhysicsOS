{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    // `@physicsos/question-paper` is compiled from source through the link: bridge
    // and is authored under PhysicsOS' root tsconfig (exactOptionalPropertyTypes
    // off). Relaxed here so this glue does not impose a stricter dialect on the
    // domain model it wraps; the plugin's own source stays exact-optional clean.
    "exactOptionalPropertyTypes": false
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../../../vendor/cosmokit"
    },
    {
      "path": "../../../vendor/cordis"
    },
    {
      "path": "../../../vendor/schemastery"
    },
    {
      "path": "../../host/webserver"
    },
    {
      "path": "../../storage/storage"
    },
    {
      "path": "../../storage/storage-domain"
    },
    {
      "path": "../../llm/llm"
    },
    {
      "path": "../../util/home-paths"
    },
    {
      "path": "../../runtime-diagnostics/invariants"
    }
  ]
}
