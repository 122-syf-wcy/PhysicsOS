{
  "name": "@deepseek-ai/dsh-experiment-host",
  "description": "PhysicsOS \u5b9e\u9a8c\u8d21\u732e host plugin: community experiment package intake (ZIP upload, server-side validation, immutable storage) and the /physicsos/experiments REST surface",
  "version": "0.1.0-rc.5",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/physicsos/experiment-host"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./assets": {
      "types": "./lib/types/routes.d.ts",
      "default": "./lib/routes.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "bundle": "tsc -b tsconfig.json && tsdown",
    "watch": "tsdown --watch"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^",
    "@deepseek-ai/dsh-host-webserver": "workspace:^",
    "@deepseek-ai/dsh-home-paths": "workspace:^",
    "@deepseek-ai/dsh-storage": "workspace:^",
    "@deepseek-ai/dsh-storage-domain": "workspace:^",
    "zod": "4.6.7",
    "yauzl": "3.4.0",
    "es-module-lexer": "2.1.0",
    "parse5": "8.0.1",
    "@physicsos/engine-optics": "link:../../../../../packages/engine-optics",
    "@physicsos/agent-tools": "link:../../../../../packages/agent-tools",
    "@physicsos/physics-scene": "link:../../../../../packages/physics-scene",
    "@physicsos/physics-runtime": "link:../../../../../packages/physics-runtime",
    "@physicsos/experiment-validation": "link:../../../../../packages/experiment-validation"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-storage-json": "workspace:^",
    "@types/yauzl": "2.10.3"
  }
}
