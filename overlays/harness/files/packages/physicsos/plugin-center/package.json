{
  "name": "@deepseek-ai/dsh-plugin-center",
  "description": "PhysicsOS plugin catalog: pinned Harness inventory, signed PhysicsOS manifests, and administrator enable/disable state",
  "version": "0.1.0-rc.5",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/physicsos/plugin-center"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./plugins/manifest.json": "./plugins/manifest.json",
    "./plugins/physicsos-plugin-signing.pub": "./plugins/physicsos-plugin-signing.pub",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "plugins/manifest.json",
    "plugins/physicsos-plugin-signing.pub"
  ],
  "scripts": {
    "bundle": "tsc -b tsconfig.json && tsdown",
    "watch": "tsdown --watch"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "dependencies": {
    "@deepseek-ai/dsh-host-plugin-inventory": "workspace:^",
    "@deepseek-ai/dsh-host-webserver": "workspace:^",
    "@deepseek-ai/dsh-package-manifest": "workspace:^",
    "@deepseek-ai/dsh-storage": "workspace:^",
    "@deepseek-ai/dsh-storage-domain": "workspace:^",
    "semver": "^7.8.5",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-storage-json": "workspace:^"
  }
}
