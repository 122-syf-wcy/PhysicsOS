{
  "name": "@deepseek-ai/dsh-client-ui-physicsos",
  "description": "PhysicsOS product overlay: brand, sidebar navigation, and home workspace on the Harness Web Client",
  "version": "0.1.0-rc.5",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-physicsos"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@physicsos/engine-magnetic": "link:../../../../../packages/engine-magnetic",
    "@physicsos/engine-circuit": "link:../../../../../packages/engine-circuit",
    "@physicsos/engine-electric": "link:../../../../../packages/engine-electric",
    "@physicsos/engine-electric-region": "link:../../../../../packages/engine-electric-region",
    "@physicsos/engine-composite": "link:../../../../../packages/engine-composite",
    "@physicsos/engine-mechanics": "link:../../../../../packages/engine-mechanics",
    "@physicsos/physics-composite-core": "link:../../../../../packages/physics-composite-core",
    "@physicsos/physics-observation": "link:../../../../../packages/physics-observation",
    "@physicsos/physics-scene": "link:../../../../../packages/physics-scene",
    "@physicsos/physics-units": "link:../../../../../packages/physics-units",
    "@physicsos/physics-verifier": "link:../../../../../packages/physics-verifier",
    "@physicsos/physics-core": "link:../../../../../packages/physics-core",
    "@physicsos/physics-electric-core": "link:../../../../../packages/physics-electric-core",
    "@physicsos/question-core": "link:../../../../../packages/question-core",
    "clsx": "^2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": "workspace:^",
    "@deepseek-ai/dsh-client-runtime": "workspace:^",
    "@deepseek-ai/dsh-client-ui-conversation": "workspace:^",
    "@deepseek-ai/dsh-client-ui-layout": "workspace:^",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:^",
    "@deepseek-ai/dsh-client-ui-sidebar": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-locale": "workspace:^",
    "@deepseek-ai/dsh-client-runtime": "workspace:^",
    "@deepseek-ai/dsh-client-test-runtime": "workspace:^",
    "@deepseek-ai/dsh-client-ui-conversation": "workspace:^",
    "@deepseek-ai/dsh-client-ui-layout": "workspace:^",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:^",
    "@deepseek-ai/dsh-client-ui-sidebar": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@types/react": "~18.3.1",
    "@deepseek-ai/cordis": "workspace:^",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
