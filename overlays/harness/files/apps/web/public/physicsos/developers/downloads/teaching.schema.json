{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "experimentId": {
      "type": "string",
      "const": "convex-lens"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "steps": {
      "minItems": 1,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "limitations": {
      "minItems": 1,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  },
  "required": [
    "schemaVersion",
    "experimentId",
    "title",
    "steps",
    "limitations"
  ],
  "additionalProperties": false
}
