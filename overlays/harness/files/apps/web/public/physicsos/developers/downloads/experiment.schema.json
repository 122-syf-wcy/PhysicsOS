{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "protocolVersion": {
      "type": "number",
      "const": 2
    },
    "packageType": {
      "type": "string",
      "const": "browser-static"
    },
    "experimentId": {
      "type": "string",
      "const": "convex-lens"
    },
    "version": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)$"
    },
    "entry": {
      "type": "string",
      "const": "dist/index.html"
    },
    "renderer": {
      "type": "string",
      "const": "three"
    },
    "theme": {
      "type": "string",
      "const": "physicsos-warm-lab-v1"
    },
    "engine": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "const": "optics"
        },
        "contractVersion": {
          "type": "number",
          "const": 1
        }
      },
      "required": [
        "id",
        "contractVersion"
      ],
      "additionalProperties": false
    },
    "parameters": {
      "type": "string",
      "const": "parameters.json"
    },
    "teaching": {
      "type": "string",
      "const": "teaching.json"
    },
    "referenceCases": {
      "type": "string",
      "const": "cases.json"
    },
    "assetLicenses": {
      "type": "string",
      "const": "ASSET-LICENSES.json"
    },
    "cover": {
      "type": "string",
      "maxLength": 240
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$"
    }
  },
  "required": [
    "schemaVersion",
    "protocolVersion",
    "packageType",
    "experimentId",
    "version",
    "entry",
    "renderer",
    "theme",
    "engine",
    "parameters",
    "teaching",
    "referenceCases",
    "assetLicenses",
    "cover",
    "license"
  ],
  "additionalProperties": false
}
