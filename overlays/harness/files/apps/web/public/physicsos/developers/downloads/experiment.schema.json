{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PhysicsOS experiment package — V1 draft, not an active upload API",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "experimentId",
    "version",
    "protocolVersion",
    "packageType",
    "entry",
    "renderer",
    "theme",
    "engine",
    "parameters",
    "cover",
    "teaching",
    "referenceCases",
    "assetLicenses",
    "license"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "experimentId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "protocolVersion": {
      "const": 1
    },
    "packageType": {
      "const": "browser-static"
    },
    "entry": {
      "const": "dist/index.html"
    },
    "parameters": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[a-zA-Z0-9_./-]+$"
    },
    "renderer": {
      "const": "three"
    },
    "theme": {
      "const": "physicsos-warm-lab-v1"
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contractVersion"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "contractVersion": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "cover": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[a-zA-Z0-9_./-]+$"
    },
    "teaching": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[a-zA-Z0-9_./-]+$"
    },
    "referenceCases": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[a-zA-Z0-9_./-]+$"
    },
    "assetLicenses": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[a-zA-Z0-9_./-]+$"
    },
    "license": {
      "type": "string",
      "minLength": 1
    }
  }
}
