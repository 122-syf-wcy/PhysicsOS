diff --git a/packages/client/connection/src/api-request-trust.ts b/packages/client/connection/src/api-request-trust.ts
index 1065dfe876..e5f5995c26 100644
--- a/packages/client/connection/src/api-request-trust.ts
+++ b/packages/client/connection/src/api-request-trust.ts
@@ -116,3 +116,35 @@ export function isTrustedApiRequest(request: ConnectionTrustRequest, trustedHost
     return false
   }
 }
+
+/**
+ * Whether the request's Host is an authority this deployment DECLARES it is
+ * reached by (`trustedHosts`) rather than the loopback origin.
+ *
+ * PhysicsOS server-deployment seam, consumed by
+ * {@link HostConnectionService.authorizeIndex}. The stock Web composition
+ * protects the document with the per-process launch token, which a browser
+ * exchanges for an authority-bound signed cookie — workable for the loopback
+ * server `dsh web` starts, unusable for a public origin behind a reverse
+ * proxy: the token is fresh on every restart and the cookie is bound to
+ * whatever authority minted it, so an operator cannot provision it for
+ * ordinary visitors. A deployment that names its public authorities here
+ * serves its own document to them. The account boundary is unchanged — every
+ * `/api` call still passes `apiPolicy`, which requires a live product session
+ * — and an invocation that declares nothing keeps the stock token flow.
+ * @param request - request headers carrying Host.
+ * @param trustedHosts - authorities this deployment declares it is reached by.
+ * @returns true only when at least one authority is declared and the Host
+ *   matches one; loopback alone and an undeclared Host never qualify.
+ */
+export function isDeclaredDeploymentAuthority(
+  request: ConnectionTrustRequest,
+  trustedHosts: readonly string[],
+): boolean {
+  if (trustedHosts.length === 0) return false
+  const host = header(request.headers, 'host')
+  if (host === undefined) return false
+  const hostUrl = parseAuthority(host)
+  if (hostUrl === undefined) return false
+  return isTrustedAuthority(hostUrl, trustedHosts)
+}
