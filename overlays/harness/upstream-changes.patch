diff --git a/packages/credentials/credentials-local/tests/desktop-format.spec.ts b/packages/credentials/credentials-local/tests/desktop-format.spec.ts
new file mode 100644
index 0000000000..31a9c7c8d1
--- /dev/null
+++ b/packages/credentials/credentials-local/tests/desktop-format.spec.ts
@@ -0,0 +1,54 @@
+import { describe, expect, it } from 'vitest'
+
+import { parseCredentialsDocument } from '../src/index.ts'
+
+/**
+ * The two writers of `$DSH_HOME/.credentials.yaml` must not fight over the shape.
+ *
+ * This package writes a FLAT `ref -> value` map. DSH Desktop 2.x rewrites the
+ * same file as a versioned `{version, records, refs}` document. Reading only the
+ * flat shape made the whole profile fail to load — `pnpm dev` exited 1 with
+ * `the value for "version" ... must be a string` — on any machine where Desktop
+ * had touched the file. These cases pin that both shapes are readable.
+ */
+const FILE = '/tmp/creds/.credentials.yaml'
+
+describe('credentials document shapes', () => {
+  it('reads the flat map this package writes', () => {
+    const entries = parseCredentialsDocument('LUCK_API_KEY: flat-secret\n', FILE)
+    expect(entries.get('LUCK_API_KEY')).toBe('flat-secret')
+    expect(entries.size).toBe(1)
+  })
+
+  it('reads the versioned document DSH Desktop writes', () => {
+    /* Shape copied from a real Desktop rewrite: `version` is a NUMBER, which is
+       exactly what the flat reader rejected. */
+    const text = [
+      'version: 1',
+      'records:',
+      '  client-connection/browser-session:',
+      '    kind: browser-session',
+      'refs:',
+      '  LUCK_API_KEY: desktop-secret',
+      '  CLINE_API_KEY: other-secret',
+      '',
+    ].join('\n')
+    const entries = parseCredentialsDocument(text, FILE)
+    expect(entries.get('LUCK_API_KEY')).toBe('desktop-secret')
+    expect(entries.get('CLINE_API_KEY')).toBe('other-secret')
+    /* `version` and `records` are NOT credentials and must not leak in as
+       references — reporting a fake key would read as "my key had no effect". */
+    expect(entries.has('version')).toBe(false)
+    expect(entries.has('records')).toBe(false)
+  })
+
+  it('still rejects a versioned document whose refs hold a non-string', () => {
+    const text = 'version: 1\nrefs:\n  LUCK_API_KEY: 7\n'
+    expect(() => parseCredentialsDocument(text, FILE)).toThrow(/must be a string/)
+  })
+
+  it('rejects a versioned document whose refs is not a mapping', () => {
+    const text = 'version: 1\nrefs:\n  - LUCK_API_KEY\n'
+    expect(() => parseCredentialsDocument(text, FILE)).toThrow()
+  })
+})
