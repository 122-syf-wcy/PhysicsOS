+// @vitest-environment jsdom
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+import { createWebConnectionRpc } from '../src/client/rpc.ts'
+
+const rpc = createWebConnectionRpc()
+
+const stubFetch = (body: BodyInit | null, status: number): void => {
+  vi.stubGlobal('fetch', vi.fn(async () => new Response(body, {
+    status,
+    headers: { 'content-type': 'application/json' },
+  })))
+}
+
+const call = (): Promise<unknown> => rpc.call('/api', 'session.prompt', {})
+
+afterEach(() => {
+  vi.unstubAllGlobals()
+})
+
+describe('non-2xx RPC responses', () => {
+  it('surfaces the policy refusal in the RPC envelope', async () => {
+    stubFetch(JSON.stringify({
+      result: {
+        ok: false,
+        error: { code: 'MODEL_BUDGET_EXCEEDED', message: '模型调用额度已用完，请稍后再试' },
+      },
+    }), 429)
+
+    await expect(call()).rejects.toThrow(
+      'HTTP 429 [MODEL_BUDGET_EXCEEDED] 模型调用额度已用完，请稍后再试',
+    )
+  })
+
+  it('surfaces a bare error body too', async () => {
+    stubFetch(JSON.stringify({
+      error: { code: 'DEPENDENCY_UNAVAILABLE', message: '限流服务暂时不可用，请稍后再试' },
+    }), 503)
+
+    await expect(call()).rejects.toThrow('HTTP 503 [DEPENDENCY_UNAVAILABLE]')
+  })
+
+  it('keeps the transport coordinates when the body carries no message', async () => {
+    stubFetch('<html>502 Bad Gateway</html>', 502)
+
+    await expect(call()).rejects.toThrow(
+      'transport failure for /api/session.prompt: HTTP 502',
+    )
