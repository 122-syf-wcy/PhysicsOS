+import type { IncomingMessage } from 'node:http'
+import type { ApiProxy } from '@deepseek-ai/dsh-host-apiproxy/api'
+import type { FetchHandler } from './http-bridge.ts'
+
+/**
+ * Optional deployment policy around every request dispatched through `/api`.
+ *
+ * The policy wraps the complete shared dispatch — the Gateway interceptor and
+ * the API Proxy fallback alike — so authentication and ownership checks cannot
+ * be bypassed by adding a method to either side later.
+ */
+export interface HostApiPolicy {
+  /** Wrap the shared Fetch dispatch for one deployment. */
+  readonly wrapFetch?: (next: FetchHandler['fetch']) => FetchHandler['fetch']
+  /**
+   * Resolve the account-scoped event source for one WebSocket upgrade.
+   * `undefined` refuses the connection.
+   */
+  readonly scopeEvents?: (
+    req: IncomingMessage,
+    events: ApiProxy['events'],
+  ) => Promise<ApiProxy['events'] | undefined>
+}
