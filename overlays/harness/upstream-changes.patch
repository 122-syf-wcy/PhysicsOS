@@ -0,0 +1,87 @@
+/**
+ * Optional account-ownership seam for the JSONL backend.
+ *
+ * The immutable {@link SessionHeader} intentionally carries no account identity:
+ * PhysicsOS keeps the authoritative `session -> schoolId:userKey` ledger in its
+ * account domain. This service lets that domain expose a synchronous lookup to
+ * the storage backend without turning the session-persistence package into an
+ * authentication dependency.
+ *
+ * @module @deepseek-ai/dsh-session-persistence-jsonl/ownership
+ */
+
+import type { SessionHeader } from '@deepseek-ai/dsh-session'
+
+/** Cordis service key for the optional account-ownership resolver. */
+export const SESSION_OWNERSHIP_SERVICE = 'physicsosSessionOwnership'
+
+/** One account owner, using the same durable vocabulary as the PhysicsOS auth domain. */
+export interface SessionOwner {
+  /** School tenant id. */
+  readonly schoolId: string
+  /** `schoolId:username`, lower-cased by the account domain. */
+  readonly userKey: string
+}
+
+/**
+ * Resolve the account that owns a session.
+ *
+ * Resolution is synchronous because {@link SessionPersistence.locate} is a
+ * side-effect-free synchronous contract. Providers may keep an in-memory index
+ * refreshed from their durable ownership table.
+ */
+export interface SessionOwnershipResolver {
+  /** Return the owner, or `undefined` when the session is legacy/unowned. */
+  resolve(meta: SessionHeader): SessionOwner | undefined
+}
+
+const SCHOOL_ID_RE = /^[A-Za-z0-9_-]{2,64}$/
+const USERNAME_RE = /^[a-z0-9][a-z0-9_.-]{2,31}$/
+
+/**
+ * Validate an owner before it can become path components. This is intentionally
+ * stricter than "no slash": it pins the durable PhysicsOS account alphabet and
+ * rejects traversal, NUL, separators, empty segments, and case ambiguity before
+ * any filesystem operation.
+ * @param value - untrusted owner value.
+ * @returns the validated owner.
+ */
+export function validateSessionOwner(value: unknown): SessionOwner {
+  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
+    throw new Error('session owner must be an object')
+  }
+  const { schoolId, userKey } = value as { schoolId?: unknown; userKey?: unknown }
+  if (typeof schoolId !== 'string' || !SCHOOL_ID_RE.test(schoolId)) {
+    throw new Error('session owner schoolId is not a valid tenant id')
+  }
+  if (typeof userKey !== 'string' || userKey.length > 97 || !userKey.startsWith(`${schoolId}:`)) {
+    throw new Error('session owner userKey must start with its schoolId')
+  }
+  const username = userKey.slice(schoolId.length + 1)
+  if (!USERNAME_RE.test(username)) {
+    throw new Error('session owner userKey has an invalid username')
+  }
+  return { schoolId, userKey }
+}
+
+/**
+ * Validate an optional resolver service.
+ * @param value - value returned by `ctx.get(SESSION_OWNERSHIP_SERVICE)`.
+ * @returns a resolver whose result is validated on every call, or `undefined`.
+ */
+export function asSessionOwnershipResolver(value: unknown): SessionOwnershipResolver | undefined {
+  if (value === undefined) return undefined
+  if (typeof value !== 'object' || value === null) {
+    throw new Error(`${SESSION_OWNERSHIP_SERVICE} must be an object`)
+  }
+  const resolve = (value as { resolve?: unknown }).resolve
+  if (typeof resolve !== 'function') {
+    throw new Error(`${SESSION_OWNERSHIP_SERVICE}.resolve must be a function`)
+  }
+  return {
+    resolve: (meta) => {
+      const owner = (resolve as (header: SessionHeader) => unknown).call(value, meta)
+      return owner === undefined ? undefined : validateSessionOwner(owner)
+    },
+  }
+}
