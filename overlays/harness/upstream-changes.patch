+/**
+ * Turn a non-2xx response into the error the caller shows.
+ *
+ * The status alone is enough to fail loud, but a policy layer may have answered
+ * with a structured refusal (`429 MODEL_BUDGET_EXCEEDED`, `503
+ * DEPENDENCY_UNAVAILABLE`, …) whose message is the only part a student can act
+ * on. Both envelopes the host uses are understood — the bare `{ error }` and the
+ * RPC `{ result: { ok: false, error } }` — and anything unreadable falls back to
+ * the transport coordinates rather than inventing a message.
+ * @param channel - RPC channel the request was sent to.
+ * @param endpoint - RPC endpoint inside the channel.
+ * @param response - the non-2xx response.
+ * @returns the message to throw.
+ */
+async function describeFailure(
+  channel: string,
+  endpoint: string,
+  response: Response,
+): Promise<string> {
+  const base = `transport failure for ${channel}/${endpoint}: HTTP ${response.status}`
+  let body: unknown
+  try {
+    body = await response.json()
+  } catch {
+    return base
+  }
+  const record = body as {
+    error?: { code?: unknown; message?: unknown }
+    result?: { error?: { code?: unknown; message?: unknown } }
+  } | null
+  const error = record?.result?.error ?? record?.error
+  const code = typeof error?.code === 'string' ? error.code : undefined
+  const message = typeof error?.message === 'string' ? error.message : undefined
+  if (code === undefined && message === undefined) return base
+  return `${base} [${code ?? 'ERROR'}] ${message ?? ''}`.trimEnd()
