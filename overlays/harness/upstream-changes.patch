+  const ctx = new Context()
+  await ctx.plugin(SessionStore)
+  if (resolver !== undefined) ctx.provide(SESSION_OWNERSHIP_SERVICE, resolver)
+  const fiber = await ctx.plugin(JsonlSessionPersistence, { root, compression: 'none' })
+  const dispose = async (): Promise<void> => {
+    await fiber.dispose()
+  }
+  disposers.push(dispose)
+  return { ctx, dispose }
+}
+
+function resolverFor(id: string, owner: SessionOwner): SessionOwnershipResolver {
+  return {
+    resolve: (meta: SessionHeader) => meta.id === id ? owner : undefined,
+  }
+}
+
+afterEach(async () => {
+  for (const dispose of disposers.splice(0).reverse()) await dispose()
+  for (const root of roots.splice(0)) await rm(root, { recursive: true, force: true })
+})
+
+describe('account-scoped JSONL layout', () => {
+  it('encodes and decodes account path segments unchanged', () => {
+    const owner = { schoolId: 'GZU', userKey: 'GZU:student.01' }
+    expect(accountLogPath('/sessions', owner, 's-1' as SessionId, 'none'))
+      .toBe('/sessions/GZU/GZU~003Astudent.01/s-1/session.jsonl')
+    expect(decodeSegment('GZU~003Astudent.01')).toBe('GZU:student.01')
+    expect(decodeSegment('~002E~002E')).toBe('..')
+  })
+
+  it('rejects unsafe or non-canonical owners before any filesystem use', () => {
+    expect(() => validateSessionOwner({ schoolId: '..', userKey: '../x' })).toThrow()
+    expect(() => validateSessionOwner({ schoolId: 'GZU', userKey: 'GZU:../x' })).toThrow()
+    expect(() => validateSessionOwner({ schoolId: 'GZU/OTHER', userKey: 'GZU:student' })).toThrow()
+    expect(() => validateSessionOwner({ schoolId: 'GZU', userKey: 'OTHER:student' })).toThrow()
+  })
+
+  it('materializes a resolved owner beneath the account-scoped directory', async () => {
+    const root = await freshRoot()
+    const owner = { schoolId: 'GZU', userKey: 'GZU:student.01' }
+    const { ctx } = await mount(root, resolverFor('account-owned', owner))
+    const header = meta('account-owned', '/private/work')
+
+    await ctx.sessionPersistence.create(header)
+    await ctx.sessionPersistence.append(header.id, oneTurnLog())
+
+    const expected = accountLogPath(root, owner, header.id, 'none')
+    expect(ctx.sessionPersistence.locate(header)).toEqual({ kind: 'jsonl', path: expected })
+    expect(await readFile(expected, 'utf8')).toContain('"id":"account-owned"')
+    expect((await ctx.sessionPersistence.load(header.id)).meta).toEqual({
+      ...header,
+      delegationDepth: 0,
+    })
+  })
+
+  it('falls back to a legacy artifact and keeps appending there after ownership appears', async () => {
+    const root = await freshRoot()
+    const header = meta('legacy-owned', '/private/work')
+    const first = await mount(root)
+    await first.ctx.sessionPersistence.create(header)
+    await first.ctx.sessionPersistence.append(header.id, oneTurnLog())
+    await first.dispose()
+
+    const legacyPath = logPath(root, header.cwd, header.id, 'none')
+    const owner = { schoolId: 'GZU', userKey: 'GZU:student.01' }
+    const second = await mount(root, resolverFor(header.id, owner))
+    expect((await second.ctx.sessionPersistence.load(header.id)).events).toHaveLength(oneTurnLog().length)
+    await second.ctx.sessionPersistence.append(header.id, [
+      { type: 'turn/start', seq: oneTurnLog().length, time: 20, data: { turn: 2 } } satisfies SessionEvent,
+    ])
+    expect(await readFile(legacyPath, 'utf8')).toContain('"turn":2')
+    await expect(readFile(accountLogPath(root, owner, header.id, 'none'), 'utf8')).rejects.toThrow()
+  })
+
+  it('reads an account artifact after a restart even when no resolver is mounted', async () => {
+    const root = await freshRoot()
+    const owner = { schoolId: 'GZU', userKey: 'GZU:student.01' }
+    const header = meta('account-restart', '/private/work')
+    const first = await mount(root, resolverFor(header.id, owner))
+    await first.ctx.sessionPersistence.create(header)
+    await first.ctx.sessionPersistence.append(header.id, oneTurnLog())
+    await first.dispose()
+
+    const second = await mount(root)
+    expect((await second.ctx.sessionPersistence.load(header.id)).events).toHaveLength(oneTurnLog().length)
+    expect((await second.ctx.sessionPersistence.list()).map(item => item.id)).toEqual([header.id])
+  })
+
+  it('rejects an unsafe resolver result instead of using it as a path', async () => {
+    const root = await freshRoot()
+    const header = meta('unsafe-owner', '/private/work')
+    const invalid = {
+      resolve: () => ({ schoolId: '..', userKey: '../student' }),
+    } as unknown as SessionOwnershipResolver
+    const { ctx } = await mount(root, invalid)
+    await ctx.sessionPersistence.create(header)
+
+    await expect(ctx.sessionPersistence.append(header.id, oneTurnLog()))
+      .rejects.toThrow(/schoolId/)
+  })
+
+  it('reports a layout conflict instead of silently choosing a copy', async () => {
+    const root = await freshRoot()
+    const header = meta('layout-conflict', '/private/work')
+    const owner = { schoolId: 'GZU', userKey: 'GZU:student.01' }
+
+    const legacy = await mount(root)
+    await legacy.ctx.sessionPersistence.create(header)
+    await legacy.ctx.sessionPersistence.append(header.id, oneTurnLog())
+    await legacy.dispose()
+
+    const accountPath = accountLogPath(root, owner, header.id, 'none')
+    await mkdir(dirname(accountPath), { recursive: true })
+    await writeFile(accountPath, await readFile(logPath(root, header.cwd, header.id, 'none')))
+
+    const reader = await mount(root)
+    await expect(reader.ctx.sessionPersistence.load(header.id))
+      .rejects.toThrow(/layout conflict/i)
+  })
+})
