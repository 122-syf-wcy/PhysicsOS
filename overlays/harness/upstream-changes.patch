diff --git a/packages/api/workspace-controller/src/index.ts b/packages/api/workspace-controller/src/index.ts
index 0b23517921..16ed0902e5 100644
--- a/packages/api/workspace-controller/src/index.ts
+++ b/packages/api/workspace-controller/src/index.ts
@@ -193,7 +193,78 @@ export class WorkspaceController extends TypertRemoteService {
    */
   @Remote({ mode: 'stream' })
   follow(signal: AbortSignal): AsyncIterable<WorkspaceFollowFrame> {
-    return this.feed.follow(signal)
+    /* PhysicsOS tenancy seam: the stock feed streams the whole registry —
+       every account's Workspace titles included. A Peer carrying workspace
+       admission sees only its own rows; absent admission keeps the stock
+       behaviour (single-operator installs, in-process carriers). */
+    const admission = workspaceAdmissionOf(this.ctx)
+    const source = this.feed.follow(signal)
+    return admission === undefined ? source : scopeWorkspaceFrames(source, admission)
+  }
+}
+
+/** Resource scoping the carrier threads onto the invoking Peer. */
+interface WorkspaceAdmission {
+  ownsWorkspace(workspaceId: string): boolean
+  ownsSession(sessionId: string): boolean
+}
+
+function workspaceAdmissionOf(ctx: Context): WorkspaceAdmission | undefined {
+  const admission = ctx.invocation?.peer.workspaceAdmission
+  if (typeof admission !== 'object' || admission === null) return undefined
+  const candidate = admission as Partial<WorkspaceAdmission>
+  if (typeof candidate.ownsWorkspace !== 'function' || typeof candidate.ownsSession !== 'function') {
+    return undefined
+  }
+  const { ownsWorkspace, ownsSession } = candidate
+  return {
+    ownsWorkspace: (id: string) => ownsWorkspace.call(admission, id),
+    ownsSession: (id: string) => ownsSession.call(admission, id),
+  }
+}
+
+export async function* scopeWorkspaceFrames(
+  source: AsyncIterable<WorkspaceFollowFrame>,
+  admission: WorkspaceAdmission,
+): AsyncIterable<WorkspaceFollowFrame> {
+  for await (const frame of source) {
+    switch (frame.type) {
+      case 'baseline': {
+        yield {
+          type: 'baseline',
+          value: {
+            items: frame.value.items.filter(item => admission.ownsWorkspace(item.workspaceId)),
+            archivedSessionIds: frame.value.archivedSessionIds.filter(id => admission.ownsSession(id)),
+            pinnedSessionIds: frame.value.pinnedSessionIds.filter(id => admission.ownsSession(id)),
+          },
+        }
+        break
+      }
+      case 'upsert': {
+        if (admission.ownsWorkspace(frame.workspace.workspaceId)) yield frame
+        break
+      }
+      case 'remove': {
+        /* A row this Peer never received needs no removal echo. */
+        if (admission.ownsWorkspace(frame.workspaceId)) yield frame
+        break
+      }
+      case 'order': {
+        const workspaceIds = frame.workspaceIds.filter(id => admission.ownsWorkspace(id))
+        if (workspaceIds.length > 0) yield { type: 'order', workspaceIds }
+        break
+      }
+      case 'archived': {
+        const archivedSessionIds = frame.archivedSessionIds.filter(id => admission.ownsSession(id))
+        if (archivedSessionIds.length > 0) yield { type: 'archived', archivedSessionIds }
+        break
+      }
+      case 'pinned': {
+        const pinnedSessionIds = frame.pinnedSessionIds.filter(id => admission.ownsSession(id))
+        if (pinnedSessionIds.length > 0) yield { type: 'pinned', pinnedSessionIds }
+        break
+      }
+    }
   }
 }

diff --git a/packages/api/workspace-controller/tests/follow-scope.host.spec.ts b/packages/api/workspace-controller/tests/follow-scope.host.spec.ts
new file mode 100644
index 0000000000..3911cc7ec9
--- /dev/null
+++ b/packages/api/workspace-controller/tests/follow-scope.host.spec.ts
@@ -0,0 +1,62 @@
+import { describe, expect, it } from 'vitest'
+import { SessionId } from '@deepseek-ai/dsh-session/types'
+import type { WorkspaceId } from '@deepseek-ai/dsh-workspace/types'
+import type { WorkspaceFollowFrame } from '../src/types.ts'
+import { scopeWorkspaceFrames } from '../src/index.ts'
+
+const admission = {
+  ownsWorkspace: (id: string) => id.startsWith('own-'),
+  ownsSession: (id: string) => id.startsWith('sess-own-'),
+}
+
+const drain = async (frames: WorkspaceFollowFrame[]): Promise<WorkspaceFollowFrame[]> => {
+  async function* source(): AsyncIterable<WorkspaceFollowFrame> { yield* frames }
+  return await collect(scopeWorkspaceFrames(source(), admission))
+}
+
+async function collect<T>(stream: AsyncIterable<T>): Promise<T[]> {
+  const out: T[] = []
+  for await (const item of stream) out.push(item)
+  return out
+}
+
+const view = (id: string) => ({ workspaceId: id as unknown as WorkspaceId, title: id, path: `/w/${id}`, sessionIds: [] }) as never
+
+describe('workspace follow tenancy scoping', () => {
+  it('filters the baseline to owned workspaces and their sessions', async () => {
+    const out = await drain([{
+      type: 'baseline',
+      value: {
+        items: [view('own-a'), view('foreign-b'), view('own-c')],
+        archivedSessionIds: [SessionId('sess-own-1'), SessionId('sess-foreign-2')],
+        pinnedSessionIds: [SessionId('sess-foreign-3')],
+      },
+    }])
+    expect(out).toEqual([{
+      type: 'baseline',
+      value: {
+        items: [view('own-a'), view('own-c')],
+        archivedSessionIds: [SessionId('sess-own-1')],
+        pinnedSessionIds: [],
+      },
+    }])
+  })
+
+  it('keeps owned upserts and drops foreign ones', async () => {
+    const out = await drain([
+      { type: 'upsert', workspace: view('own-a') },
+      { type: 'upsert', workspace: view('foreign-b') },
+    ])
+    expect(out).toEqual([{ type: 'upsert', workspace: view('own-a') }])
+  })
+
+  it('drops removals, orders, archives and pins that name nothing owned', async () => {
+    const out = await drain([
+      { type: 'remove', workspaceId: 'foreign-b' as unknown as WorkspaceId },
+      { type: 'order', workspaceIds: ['foreign-b', 'own-a'] as unknown as WorkspaceId[] },
+      { type: 'archived', archivedSessionIds: [SessionId('sess-foreign-2')] },
+      { type: 'pinned', pinnedSessionIds: [SessionId('sess-foreign-3')] },
+    ])
+    expect(out).toEqual([{ type: 'order', workspaceIds: ['own-a'] }])
+  })
+})
