{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "minItems": 1,
  "maxItems": 1000,
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "maxLength": 240
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "license": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$"
      },
      "source": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "notice": {
        "type": "string",
        "maxLength": 240
      }
    },
    "required": [
      "path",
      "name",
      "license",
      "source"
    ],
    "additionalProperties": false
  }
}
