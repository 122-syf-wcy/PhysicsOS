{
  "name": "PhysicsOS Development",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24",
      "nodeGypDependencies": true
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "containerEnv": {
    "COREPACK_ENABLE_STRICT": "0",
    "PNPM_HOME": "/home/vscode/.local/share/pnpm",
    "PATH": "/home/vscode/.local/share/pnpm:${containerEnv:PATH}"
  },
  "remoteUser": "vscode",
  "postCreateCommand": "bash .devcontainer/bootstrap.sh",
  "forwardPorts": [3080],
  "portsAttributes": {
    "3080": {
      "label": "PhysicsOS Web",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-azuretools.vscode-docker", "oxc.oxc-vscode", "rust-lang.rust-analyzer"]
    }
  }
}
