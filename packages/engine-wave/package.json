    "build": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@physicsos/shared": "file:../shared",
    "@physicsos/physics-units": "file:../physics-units",
    "@physicsos/physics-math": "file:../physics-math",
    "@physicsos/physics-core": "file:../physics-core",
    "@physicsos/physics-scene": "file:../physics-scene"
  }
}
